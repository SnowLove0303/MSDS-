{
  "rule_catalog_id": "section2_rule_catalog",
  "version": "1.0.0",
  "language": "zh-CN",
  "rule_status": ["verified", "screening_gate", "skeleton_pending_clause_review"],
  "rules": [
    {
      "id": "FL-001",
      "endpoint": "flammable_liquid",
      "type": "classification",
      "status": "verified",
      "priority": 10,
      "applies_when": "目标市场为 CN，产品为液体，且闪点和初沸点为可比较的成品级事实",
      "inputs": ["flash_point", "initial_boiling_point"],
      "predicate": {"all": [{"field": "flash_point", "operator": "<", "value": 23, "unit": "℃"}, {"field": "initial_boiling_point", "operator": "<=", "value": 35, "unit": "℃"}]},
      "output_key": "flammable_liquid_category_1",
      "legal_sources": [{"id": "GB30000.7-2013", "basis": "易燃液体分类阈值与标签要素"}],
      "missing_data_policy": "manual_review",
      "trace_requirement": "保留闪点、初沸点原始值、单位、来源和判定时间"
    },
    {
      "id": "FL-002",
      "endpoint": "flammable_liquid",
      "type": "classification",
      "status": "verified",
      "priority": 20,
      "applies_when": "目标市场为 CN，产品为液体，且闪点和初沸点为可比较的成品级事实",
      "inputs": ["flash_point", "initial_boiling_point"],
      "predicate": {"all": [{"field": "flash_point", "operator": "<", "value": 23, "unit": "℃"}, {"field": "initial_boiling_point", "operator": ">", "value": 35, "unit": "℃"}]},
      "output_key": "flammable_liquid_category_2",
      "legal_sources": [{"id": "GB30000.7-2013", "basis": "易燃液体分类阈值与标签要素"}],
      "missing_data_policy": "manual_review",
      "trace_requirement": "保留闪点、初沸点原始值、单位、来源和判定时间"
    },
    {
      "id": "FL-003",
      "endpoint": "flammable_liquid",
      "type": "classification",
      "status": "verified",
      "priority": 30,
      "applies_when": "目标市场为 CN，产品为液体，且闪点为成品级可比较事实",
      "inputs": ["flash_point"],
      "predicate": {"all": [{"field": "flash_point", "operator": ">=", "value": 23, "unit": "℃"}, {"field": "flash_point", "operator": "<=", "value": 60, "unit": "℃"}]},
      "output_key": "flammable_liquid_category_3",
      "legal_sources": [{"id": "GB30000.7-2013", "basis": "易燃液体分类阈值与标签要素"}],
      "missing_data_policy": "manual_review",
      "trace_requirement": "保留闪点原始值、单位、来源和判定时间"
    },
    {
      "id": "FL-004",
      "endpoint": "flammable_liquid",
      "type": "classification",
      "status": "verified",
      "priority": 40,
      "applies_when": "目标市场为 CN，产品为液体，且闪点为成品级可比较事实",
      "inputs": ["flash_point"],
      "predicate": {"all": [{"field": "flash_point", "operator": ">", "value": 60, "unit": "℃"}, {"field": "flash_point", "operator": "<=", "value": 93, "unit": "℃"}]},
      "output_key": "flammable_liquid_category_4",
      "legal_sources": [{"id": "GB30000.7-2013", "basis": "易燃液体类别 4；H227；信号词警告；不配置象形图"}],
      "missing_data_policy": "manual_review",
      "trace_requirement": "保留闪点原始值、单位、来源和判定时间"
    },
    {
      "id": "FL-005",
      "endpoint": "flammable_liquid",
      "type": "evidence_gate",
      "status": "verified",
      "priority": 90,
      "applies_when": "闪点缺失，或闪点低于 23 ℃但初沸点缺失，或比较符/范围导致边界无法唯一确定",
      "inputs": ["flash_point", "initial_boiling_point"],
      "predicate": {"any": ["flash_point_missing", "initial_boiling_point_required_but_missing", "range_crosses_boundary", "comparison_operator_unresolved"]},
      "output_key": null,
      "decision": "manual_review",
      "legal_sources": [{"id": "GB30000.7-2013", "basis": "分类条件需要相应成品级物性事实"}],
      "missing_data_policy": "不得输出无危害；保留缺失事实列表"
    },
    {
      "id": "FL-006",
      "endpoint": "flammable_liquid",
      "type": "endpoint_result",
      "status": "verified",
      "priority": 100,
      "applies_when": "闪点明确高于 93 ℃，且没有范围/比较符冲突",
      "inputs": ["flash_point"],
      "predicate": {"all": [{"field": "flash_point", "operator": ">", "value": 93, "unit": "℃"}]},
      "output_key": "not_classified_under_endpoint",
      "decision": "not_classified_under_flammable_liquid_endpoint",
      "legal_sources": [{"id": "GB30000.7-2013", "basis": "不满足该易燃液体分类范围"}],
      "missing_data_policy": "不得据此否定其他物理、健康或环境危害"
    },
    {
      "id": "MIX-001",
      "endpoint": "mixture_health_and_environment",
      "type": "evidence_gate",
      "status": "screening_gate",
      "priority": 200,
      "applies_when": "需要由组分推导成品健康或环境危害",
      "inputs": ["component.cas", "component.name", "component.concentration", "component.ghs_classification"],
      "predicate": {"all": ["cas_resolved", "concentration_resolved", "component_classification_source_resolved"]},
      "decision": "eligible_for_mixture_rule_evaluation",
      "legal_sources": [{"id": "GB30000.1-2024", "basis": "GHS 通则适用范围"}, {"id": "GB-T17519-2013", "basis": "混合物信息组织和分类证据要求"}],
      "missing_data_policy": "任一输入缺失则 manual_review，不得把组分 H 代码直接继承到成品"
    },
    {
      "id": "MIX-002",
      "endpoint": "mixture_health_and_environment",
      "type": "evidence_gate",
      "status": "screening_gate",
      "priority": 210,
      "applies_when": "组分含量为未知、保密、无数据，或浓度区间跨越候选阈值",
      "inputs": ["component.concentration"],
      "predicate": {"any": ["concentration_unknown", "concentration_confidential", "range_crosses_threshold"]},
      "decision": "manual_review",
      "legal_sources": [{"id": "GB-T17519-2013", "basis": "混合物分类需要可用的组分信息和浓度证据"}],
      "missing_data_policy": "未知不等于 0%，未知不等于无危害"
    },
    {
      "id": "MIX-003",
      "endpoint": "mixture_health_and_environment",
      "type": "screening_threshold",
      "status": "screening_gate",
      "priority": 220,
      "applies_when": "已解析 CAS、组分含量和组分危害分类来源，准备进入混合物规则计算",
      "thresholds_percent": {
        "acute_toxicity": 1.0,
        "skin_corrosion_or_irritation": 1.0,
        "serious_eye_damage_or_irritation": 1.0,
        "sensitization": 0.1,
        "carcinogenicity": 0.1,
        "germ_cell_mutagenicity": 0.1,
        "reproductive_toxicity": 0.1,
        "stot": 1.0,
        "aquatic_hazard": 1.0
      },
      "decision": "screening_only",
      "legal_sources": [{"id": "GB-T17519-2013", "basis": "本地 PDF 已核验的混合物阈值表；不得脱离具体危害类别和完整加和规则使用"}],
      "missing_data_policy": "阈值筛查通过不等于最终成品分类完成"
    },
    {
      "id": "MIX-004",
      "endpoint": "mixture_health_and_environment",
      "type": "prohibition",
      "status": "verified",
      "priority": 230,
      "applies_when": "仅有某组分的 H 代码，但没有成品浓度或完整混合物证据",
      "inputs": ["component.ghs_classification", "component.concentration"],
      "predicate": {"all": ["component_h_code_present", "product_level_mixture_evidence_missing"]},
      "decision": "do_not_inherit_component_h_code",
      "legal_sources": [{"id": "GB30000.1-2024", "basis": "成品分类需按适用分类规则判断"}, {"id": "GB-T17519-2013", "basis": "混合物 SDS 信息和分类依据"}],
      "missing_data_policy": "manual_review"
    },
    {
      "id": "LBL-001",
      "endpoint": "label_elements",
      "type": "mapping",
      "status": "verified",
      "priority": 300,
      "applies_when": "分类结果已经确定",
      "inputs": ["classification_result"],
      "mapping": "classification_result.output_key -> result_library.classification_results",
      "legal_sources": [{"id": "GB30000.1-2024", "basis": "分类与标签要素"}, {"id": "GB15258-2009", "basis": "安全标签编写要素"}],
      "missing_data_policy": "分类未确定时不得生成正式标签元素"
    },
    {
      "id": "LBL-002",
      "endpoint": "pictogram",
      "type": "mapping",
      "status": "verified",
      "priority": 310,
      "applies_when": "存在最终 H 代码或已确定分类结果",
      "inputs": ["h_code"],
      "mapping": "h_code -> result_library.h_code_to_pictograms",
      "exceptions": [{"h_code": "H227", "pictograms": [], "reason": "易燃液体类别 4 不配置象形图"}],
      "legal_sources": [{"id": "GB30000.7-2013", "basis": "类别 4 标签要素"}, {"id": "GB15258-2009", "basis": "象形图编排"}],
      "missing_data_policy": "不得根据字段名称或旧图片猜测象形图"
    }
  ]
}
